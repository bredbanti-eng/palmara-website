# Get from https://aistudio.google.com/app/apikey (free tier available)
GEMINI_API_KEY=

# Get from your Supabase project -> Settings -> API
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Get from Razorpay dashboard -> Settings -> API Keys (use Test Mode first)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Get from Razorpay dashboard -> Settings -> Webhooks, after deploying,
# pointing at https://palmara.in/api/payment/webhook for "payment.captured"
RAZORPAY_WEBHOOK_SECRET=

# Get from https://resend.com/api-keys (3,000 free emails/month, permanent)
# Requires verifying a sending domain (e.g. palmara.in) in Resend's dashboard first
RESEND_API_KEY=

# Your live site URL, used to build the report link inside emails
NEXT_PUBLIC_SITE_URL=https://palmara.in
